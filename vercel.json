{
  "rewrites": [
    {
      "source": "/nominee/:id",
      "destination": "https://dgugpfpotxwyoiycracf.supabase.co/functions/v1/share?nominee=:id"
    },
    {
      "source": "/song/:id",
      "destination": "https://dgugpfpotxwyoiycracf.supabase.co/functions/v1/share?song=:id"
    },
    {
      "source": "/video/:id",
      "destination": "https://dgugpfpotxwyoiycracf.supabase.co/functions/v1/share?video=:id"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite"
}
